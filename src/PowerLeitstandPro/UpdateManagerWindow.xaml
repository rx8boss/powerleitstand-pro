<Window x:Class="PowerControlProWpf.UpdateManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 FontSize="13" Title="PowerLeitstand PRO · Updates" Icon="Assets/app-icon.ico" Width="620" Height="480" MinWidth="340" MinHeight="340"
 WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource DialogBackground}" Foreground="{DynamicResource DialogText}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="HeaderIconButton" TargetType="Button">
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource DialogText}"/><Setter Property="Background" Value="{DynamicResource DialogInput}"/><Setter Property="BorderBrush" Value="{DynamicResource DialogLine}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="IconFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconFrame" Property="BorderBrush" Value="{DynamicResource DialogAccent}"/><Setter Property="Foreground" Value="{DynamicResource DialogAccent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="IconFrame" Property="BorderBrush" Value="{DynamicResource DialogAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HeaderCloseStyle" TargetType="Button" BasedOn="{StaticResource HeaderIconButton}">
   <Setter Property="Foreground" Value="#FF4B4B"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#E92749"/><Setter Property="BorderBrush" Value="#E92749"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FF2448" ShadowDepth="0" BlurRadius="11" Opacity="0.7"/></Setter.Value></Setter></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#8F132B"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource DialogButtonBackground}"/><Setter Property="Foreground" Value="{DynamicResource DialogText}"/><Setter Property="BorderBrush" Value="{DynamicResource DialogAccent}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFrame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFrame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonFrame" Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Background" Value="#642035"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FF5370"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#98283F"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FF2448" ShadowDepth="0" BlurRadius="10" Opacity="0.5"/></Setter.Value></Setter></Trigger></Style.Triggers></Style>
  <Style x:Key="Choice" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ChoiceFrame" Background="{DynamicResource DialogInput}" BorderBrush="{DynamicResource DialogLine}" BorderThickness="1" CornerRadius="8" Padding="9,6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="{DynamicResource DialogAccent}"/><Setter TargetName="ChoiceFrame" Property="BorderThickness" Value="2"/><Setter TargetName="ChoiceFrame" Property="Background" Value="{DynamicResource DialogButtonBackground}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceFrame" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
 </Window.Resources>
 <Border x:Name="DialogFrame" Background="{DynamicResource DialogSurface}" BorderBrush="{DynamicResource DialogAccent}" BorderThickness="1.3" CornerRadius="11" Padding="16">
  <Grid x:Name="RootLayout">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Width="110" Height="60" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-16,18,0" ClipToBounds="True" IsHitTestVisible="False"><Path Data="M 65,0 L 67,0 L 8,60 L 6,60 Z M 90,0 L 92,0 L 33,60 L 31,60 Z M 94,0 L 110,0 L 51,60 L 35,60 Z" Fill="{DynamicResource DialogAccent}" Opacity="0.22"/></Grid>
   <Grid Margin="0,0,0,10" MouseLeftButtonDown="DragHeader">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
    <Button x:Name="BackButton" Visibility="Collapsed" Margin="0,0,8,0" Style="{StaticResource HeaderIconButton}" ToolTip="Zurück" AutomationProperties.Name="Zurück" Click="BackToUpdates"><Path Data="M 8,1 L 2,8 L 8,15" Width="8" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
    <Path x:Name="Bolt" Grid.Column="1" Data="M 18,0 L 3,24 L 15,24 L 9,43 L 31,14 L 18,14 Z" Fill="{DynamicResource DialogAccent}" Width="27" Height="40" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="2"><TextBlock x:Name="HeaderText" Text="Updates und Wiederherstellung" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="PowerLeitstand PRO" Foreground="{DynamicResource DialogSubtleText}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
    <Button x:Name="HeaderCloseButton" Grid.Column="3" Style="{StaticResource HeaderCloseStyle}" ToolTip="Schließen" AutomationProperties.Name="Schließen" Click="CloseWindow"><Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
   </Grid>
   <Border x:Name="VersionSummary" Grid.Row="1" Background="{DynamicResource DialogInput}" BorderBrush="{DynamicResource DialogLine}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"><WrapPanel><TextBlock x:Name="InstalledText" FontSize="14" FontWeight="SemiBold" Margin="0,0,20,0"/><TextBlock x:Name="LatestText" FontSize="13" Foreground="{DynamicResource DialogAccent}" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel></Border>
   <ScrollViewer Grid.Row="2" x:Name="BodyScroll" SizeChanged="BodySizeChanged" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="BodyGrid"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid x:Name="ListPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="ListHeading" Text="Version auswählen" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
      <TextBlock x:Name="ListHint" Grid.Row="1" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource DialogSubtleText}" Visibility="Collapsed"/>
      <ListBox Grid.Row="2" x:Name="VersionList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource DialogText}" MaxHeight="166" ItemContainerStyle="{StaticResource Choice}" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="VersionSelected">
       <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Subtitle}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource DialogAccent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="3" x:Name="ListScrollHint" Text="⌄ Weitere Versionen durch Scrollen" Foreground="{DynamicResource DialogSubtleText}" FontSize="10" Margin="0,2,0,2" Visibility="Collapsed"/>
     </Grid>
     <TextBlock Grid.Row="1" x:Name="VerificationText" Visibility="Collapsed" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,5"/>

    </Grid>
   </ScrollViewer>
   <Border x:Name="DetailPanel" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" BorderBrush="{DynamicResource DialogLine}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="DetailHeading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
     <TextBlock Grid.Row="1" x:Name="DetailSubheading" Foreground="{DynamicResource DialogSubtleText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
      <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ScrollChanged="NotesScrolled" Focusable="True" ToolTip="Mit Mausrad oder Pfeiltasten scrollen"><TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13" LineHeight="21"/></ScrollViewer>
      <Button x:Name="NotesUp" Grid.Column="1" Content="⌃" Foreground="{DynamicResource DialogAccent}" FontSize="21" VerticalAlignment="Top" MinHeight="24" Padding="0" Style="{StaticResource ActionButton}" Click="ScrollNotesUp" Visibility="Collapsed"/>
      <Button x:Name="NotesDown" Grid.Column="1" Content="⌄" Foreground="{DynamicResource DialogAccent}" FontSize="21" VerticalAlignment="Bottom" MinHeight="24" Padding="0" Style="{StaticResource ActionButton}" Click="ScrollNotesDown" Visibility="Collapsed"/>
     </Grid>
     <TextBlock Grid.Row="3" x:Name="NotesHint" Text="Weitere Änderungen durch Scrollen" FontSize="10" Foreground="{DynamicResource DialogSubtleText}" Margin="0,4,0,0" Visibility="Collapsed"/>
     <TextBlock Grid.Row="4" x:Name="InstallHint" Text="Hinweise" FontSize="12" FontWeight="SemiBold" Margin="0,7,0,3"/>
     <TextBlock Grid.Row="5" x:Name="KeepHint" Text="Einstellungen und Protokolle bleiben erhalten. Aktive Timer oder Reparaturen zuerst beenden." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource DialogSubtleText}"/>
    </Grid>
   </Border>
   <StackPanel Grid.Row="3" x:Name="OverviewActions">
     <UniformGrid  x:Name="DetailActions" Columns="2" Margin="0,5,0,8"><Button x:Name="ChangesButton" Content="Änderungen anzeigen …  ›" Style="{StaticResource ActionButton}" Click="OpenNotes"/><Button x:Name="DeleteBackupButton" Content="Sicherung löschen …" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="DeleteBackup" Visibility="Collapsed"/></UniformGrid>
   <Border x:Name="RecoveryPanel" Margin="0,7,0,9"><StackPanel><TextBlock x:Name="RecoveryHeading" Visibility="Collapsed"/><Button x:Name="RecoveryButton" Content="Wiederherstellungspunkte …  ›" Style="{StaticResource ActionButton}" HorizontalContentAlignment="Stretch" Click="OpenRecovery"/><TextBlock x:Name="BackupLocation" FontSize="10" Foreground="{DynamicResource DialogSubtleText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
   </StackPanel>
   <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <UniformGrid x:Name="FooterButtons" Columns="2"><Button x:Name="InstallButton" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="InstallSelected"><TextBlock x:Name="InstallCaption" Text="Version installieren" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/></Button><Button x:Name="CloseButton" Content="Schließen" Style="{StaticResource DangerButton}" Click="CloseWindow"/></UniformGrid>
    <TextBlock Grid.Row="1" x:Name="StatusText" FontSize="10" TextWrapping="Wrap" MaxHeight="28" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DialogSubtleText}" Margin="0,5,0,0"/>
   </Grid>
  </Grid>
 </Border>
</Window>
