<Window x:Class="PowerControlProWpf.TrayQuickWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PowerLeitstand PRO · Schnellzugriff" Width="384" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <Style x:Key="TrayAction" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource TrayText}"/><Setter Property="Background" Value="{DynamicResource TrayButton}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource TrayAccent}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="Height" Value="52"/><Setter Property="Margin" Value="0,0,0,7"/>
   <Setter Property="Padding" Value="9,4"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource TrayHover}"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="danger"/></MultiTrigger.Conditions><Setter TargetName="Frame" Property="Background" Value="#9E233F"/></MultiTrigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.75"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="TrayDanger" TargetType="Button" BasedOn="{StaticResource TrayAction}">
   <Setter Property="Tag" Value="danger"/>
   <Setter Property="Background" Value="{DynamicResource TrayDangerBackground}"/><Setter Property="BorderBrush" Value="#FF415D"/>
   <Setter Property="Foreground" Value="White"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True">
    <Setter Property="Background" Value="#9E233F"/>
    <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FF2448" ShadowDepth="0" BlurRadius="12" Opacity="0.55"/></Setter.Value></Setter>
   </Trigger></Style.Triggers>
  </Style>
  <Style x:Key="TrayExit" TargetType="Button" BasedOn="{StaticResource TrayDanger}">
   <Setter Property="BorderThickness" Value="2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ExitFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter x:Name="ExitBody" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ExitFrame" Property="Background" Value="#9E233F"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ExitFrame" Property="BorderThickness" Value="3"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ExitBody" Property="Opacity" Value="0.75"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ExitBody" Property="Opacity" Value="0.38"/><Setter TargetName="ExitFrame" Property="BorderBrush" Value="#AA5366"/><Setter TargetName="ExitFrame" Property="Background" Value="{DynamicResource TrayDangerBackground}"/><Setter Property="Effect" Value="{x:Null}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="MenuFrame" CornerRadius="11" Background="{DynamicResource TraySurface}" BorderBrush="{DynamicResource TrayAccent}" BorderThickness="1.3" Padding="15" Margin="5">
  <Grid>
   <Grid IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Width="74" Height="58" ClipToBounds="True" Margin="0,-14,-14,0">
    <Path Data="M 42,-4 L 54,-4 L 3,58 L -9,58 Z M 65,-4 L 77,-4 L 26,58 L 14,58 Z" Fill="{DynamicResource TrayAccent}" Opacity="0.28"/>
   </Grid>
   <ScrollViewer x:Name="MenuScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <StackPanel>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
      <Path Data="M 18,0 L 3,24 L 15,24 L 9,43 L 31,14 L 18,14 Z" Fill="{DynamicResource TrayAccent}" Stretch="Uniform" Width="27" Height="40" HorizontalAlignment="Left"/>
      <StackPanel Grid.Column="1"><TextBlock Text="PowerLeitstand PRO" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Text="Schnellzugriff" FontSize="12" Foreground="{DynamicResource TraySubtle}" Margin="0,3,0,0"/></StackPanel>
      <Button x:Name="CenterButton" Grid.Column="2" Content="⊕" FontSize="16" Height="26" Padding="1" Margin="0" Style="{StaticResource TrayAction}" ToolTip="Fenster zentrieren" Click="CenterWindow"/>
     </Grid>
     <Rectangle Height="1" Fill="{DynamicResource TrayAccent}" Opacity="0.35" Margin="0,0,0,12"/>
     <StackPanel Orientation="Horizontal" Margin="1,0,0,12"><Ellipse x:Name="StateDot" Width="9" Height="9" Margin="0,0,8,0"/><TextBlock x:Name="StateText" FontSize="13"/></StackPanel>
     <Border x:Name="TimerCard" BorderBrush="{DynamicResource TrayLine}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" Background="{DynamicResource TrayInset}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="133"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock x:Name="TimerHeading" Text="Timer läuft" Foreground="{DynamicResource TraySubtle}" FontSize="12"/><TextBlock x:Name="RemainingText" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="ActionText" FontSize="12" Foreground="{DynamicResource TraySubtle}"/></StackPanel>
       <Button x:Name="CancelTimerButton" Grid.Column="1" Style="{StaticResource TrayDanger}" Height="37" Margin="3,0,0,0" Click="CancelTimer"><StackPanel Orientation="Horizontal"><TextBlock Text="■" Margin="0,0,5,0"/><TextBlock x:Name="CancelTimerCaption" Text="Timer abbrechen" FontSize="11"/></StackPanel></Button>
      </Grid>
     </Border>
     <Button x:Name="OpenButton" Height="40" Style="{StaticResource TrayAction}" Click="OpenWindow"><StackPanel Orientation="Horizontal"><Grid Width="23" Height="21" Margin="0,0,9,0" VerticalAlignment="Center"><Path Data="M 2,4 L 17,4 L 17,19 L 2,19 Z M 2,8 L 10,8" Stroke="{Binding Foreground, ElementName=OpenButton}" StrokeThickness="1.5" StrokeLineJoin="Round"/><Path Data="M 10,11 L 21,1 M 13,1 L 21,1 L 21,9" Stroke="{Binding Foreground, ElementName=OpenButton}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Grid><TextBlock x:Name="OpenCaption" Text="Fenster öffnen" VerticalAlignment="Center"/></StackPanel></Button>
     <Rectangle Height="1" Fill="{DynamicResource TrayAccent}" Opacity="0.3" Margin="0,6,0,10"/>
     <TextBlock x:Name="ActionsHeading" Text="Systemaktionen" Foreground="{DynamicResource TraySubtle}" FontSize="12" Margin="0,0,0,9"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <Button x:Name="ShutdownButton" Style="{StaticResource TrayAction}" Click="SystemAction" Tag="shutdown" BorderBrush="#F4516D" Background="{DynamicResource TrayDangerBackground}"><StackPanel Orientation="Horizontal"><Image x:Name="ShutdownIcon" Width="26" Height="26" Margin="0,0,7,0"/><TextBlock x:Name="ShutdownCaption" Text="Herunterfahren" VerticalAlignment="Center" FontSize="12"/></StackPanel></Button>
      <Button x:Name="RestartButton" Grid.Column="2" Style="{StaticResource TrayAction}" Click="SystemAction" Tag="restart"><StackPanel Orientation="Horizontal"><Image x:Name="RestartIcon" Width="26" Height="26" Margin="0,0,8,0"/><TextBlock x:Name="RestartCaption" Text="Neustart" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="LogoutButton" Grid.Row="1" Style="{StaticResource TrayAction}" Click="SystemAction" Tag="logout"><StackPanel Orientation="Horizontal"><Image x:Name="LogoutIcon" Width="26" Height="26" Margin="0,0,8,0"/><TextBlock x:Name="LogoutCaption" Text="Abmelden" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="LockButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource TrayAction}" Click="SystemAction" Tag="lock"><StackPanel Orientation="Horizontal"><Image x:Name="LockIcon" Width="26" Height="26" Margin="0,0,8,0"/><TextBlock x:Name="LockCaption" Text="Sperren" VerticalAlignment="Center"/></StackPanel></Button>
     </Grid>
     <TextBlock x:Name="GuardHint" FontSize="11" Foreground="{DynamicResource TraySubtle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <Button x:Name="ExitButton" Style="{StaticResource TrayExit}" Height="40" Margin="0" Click="ExitProgram"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ExitCross" Text="×" FontSize="24" Foreground="#FF6076" Margin="0,-4,9,0"/><TextBlock x:Name="ExitCaption" Text="Programm beenden" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Border>
</Window>
