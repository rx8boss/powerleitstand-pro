<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Style TargetType="RadioButton">
       <Setter Property="Foreground" Value="{DynamicResource DialogText}"/><Setter Property="Margin" Value="0,0,4,0"/>
       <Setter Property="Padding" Value="5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="42"/><Setter Property="FontSize" Value="11"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="ChannelFrame" Background="{DynamicResource DialogInput}" BorderBrush="{DynamicResource DialogLine}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
         <DockPanel LastChildFill="True" VerticalAlignment="Center">
          <Grid Width="11" Height="11" Margin="0,0,5,0"><Ellipse Stroke="{DynamicResource DialogAccent}"/><Ellipse x:Name="Mark" Width="5" Height="5" Fill="{DynamicResource DialogAccent}" Visibility="Collapsed"/></Grid>
          <StackPanel>
           <TextBlock Text="{TemplateBinding Content}" FontWeight="SemiBold" TextWrapping="Wrap"/>
           <TextBlock x:Name="ChannelHint" Text="{TemplateBinding Tag}" FontSize="10" Foreground="{DynamicResource DialogSubtleText}" TextWrapping="Wrap"/>
          </StackPanel>
         </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="ChannelHint" Property="Visibility" Value="Collapsed"/></Trigger>
         <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChannelFrame" Property="Background" Value="{DynamicResource DialogButtonBackground}"/><Setter TargetName="ChannelFrame" Property="BorderBrush" Value="{DynamicResource DialogAccent}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
         <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChannelFrame" Property="BorderThickness" Value="2"/></Trigger>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChannelFrame" Property="BorderBrush" Value="{DynamicResource DialogAccent}"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
      </Style>
</ResourceDictionary>
