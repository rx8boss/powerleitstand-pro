<Window x:Class="PowerControlProWpf.ThemedMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerLeitstand PRO" Icon="Assets/app-icon.ico"
        Width="374" MinHeight="140" MaxHeight="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
  <Window.Resources>
    <LinearGradientBrush x:Key="DialogSurface" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#10344F" Offset="0"/><GradientStop Color="#061B30" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="DialogSheen" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#20FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush>
    <Style x:Key="DialogButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource DialogText}"/>
      <Setter Property="Background" Value="{DynamicResource DialogButtonBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DialogBorder}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.3"
                CornerRadius="7" SnapsToDevicePixels="True">
          <Grid><Border Background="{DynamicResource DialogSheen}" CornerRadius="6" IsHitTestVisible="False"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DialogHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButton}">
      <Setter Property="BorderBrush" Value="{DynamicResource DialogDangerBorder}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.3"
                CornerRadius="7" SnapsToDevicePixels="True">
          <Grid>
            <Border Background="{DynamicResource DialogSheen}" CornerRadius="6" IsHitTestVisible="False"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DialogDangerBackground}"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
      <Setter Property="Background" Value="{DynamicResource DialogDangerBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DialogDangerBorder}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.3"
                CornerRadius="7" SnapsToDevicePixels="True">
          <Grid><Border Background="{DynamicResource DialogSheen}" CornerRadius="6" IsHitTestVisible="False"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DialogDangerHover}"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource DialogDangerBorder}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ReferenceCancelButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{DynamicResource DialogDangerBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DialogDangerBorder}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="RedCancelFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1.3" CornerRadius="7" TextElement.Foreground="#FF7B8E">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="RedCancelFrame" Property="Background" Value="{DynamicResource DialogDangerHover}"/>
            <Setter TargetName="RedCancelFrame" Property="TextElement.Foreground" Value="White"/>
            <Setter TargetName="RedCancelFrame" Property="Effect"><Setter.Value><DropShadowEffect Color="#FF2448" ShadowDepth="0" BlurRadius="14" Opacity="0.8"/></Setter.Value></Setter>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="RedCancelFrame" Property="Opacity" Value="0.75"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RedCancelFrame" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RedCancelFrame" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="DialogFrame" Background="{DynamicResource DialogSurface}" BorderBrush="{DynamicResource DialogBorder}"
          BorderThickness="1.5" Padding="14" CornerRadius="11">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="33"/></Grid.RowDefinitions>
      <Path x:Name="LegacyCorner" Grid.RowSpan="4" Data="M 0 0 L 38 0 M 0 0 L 38 38" Stroke="{DynamicResource DialogBorder}" StrokeThickness="1" Opacity="0.55" HorizontalAlignment="Right" VerticalAlignment="Top" Width="38" Height="38" IsHitTestVisible="False"/>
      <Grid x:Name="DialogStripes" Grid.RowSpan="4" Width="78" Height="45" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
        <Path Data="M 59,0 L 78,0 L 78,20 L 53,45 L 14,45 Z" Fill="{DynamicResource DialogBorder}" Opacity="0.10"/>
        <Path Data="M 49,0 L 4,45 M 68,0 L 23,45" Stroke="{DynamicResource DialogBorder}" StrokeThickness="0.7" Opacity="0.55"/>
      </Grid>
      <Grid Grid.Row="0" MouseLeftButtonDown="DragDialog">
        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Width="33" Height="33" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Border x:Name="IconBadge" Width="31" Height="31" CornerRadius="16" BorderThickness="1.5"
                  BorderBrush="{DynamicResource DialogIconBrush}">
            <TextBlock x:Name="DialogSymbol" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource DialogIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Path x:Name="WarningTriangle" Data="M 16,1 L 31,30 L 1,30 Z"
                Fill="{DynamicResource DialogIconBrush}" Visibility="Collapsed"/>
          <TextBlock x:Name="WarningMark" Text="!" FontSize="18" FontWeight="Bold"
                     Foreground="{DynamicResource DialogBackground}" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed"/>
          <Path x:Name="ActionGlyph" Visibility="Collapsed" Width="30" Height="30"
                Stretch="Uniform" Fill="{DynamicResource DialogIconBrush}"
                Stroke="{DynamicResource DialogIconBrush}" StrokeThickness="1.4"/>
        </Grid>
        <TextBlock x:Name="DialogTitle" Grid.Column="1" FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource DialogText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </Grid>
      <ScrollViewer Grid.Row="1" Margin="44,6,0,0" MaxHeight="190" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="DialogMessage" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource DialogText}"/>
      </ScrollViewer>
      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="ConfirmButton" Grid.Column="0" Height="33" Margin="0,0,5,0"
                Style="{StaticResource DialogButton}" Click="ConfirmDialog"/>
        <Button x:Name="CancelButton" Grid.Column="1" Height="33" Margin="5,0,0,0"
                Style="{StaticResource CancelButtonStyle}" Click="CancelDialog"/>
      </Grid>
    </Grid>
  </Border>
</Window>
