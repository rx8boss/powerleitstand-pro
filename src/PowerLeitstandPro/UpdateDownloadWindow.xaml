<Window x:Class="PowerControlProWpf.UpdateDownloadWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PowerLeitstand PRO" Icon="Assets/app-icon.ico" Width="464" Height="259"
 WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource DialogBackground}" Foreground="{DynamicResource DialogText}"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <Style x:Key="CancelButtonStyle" TargetType="Button">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{DynamicResource DialogDangerBackground}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource DialogDangerBorder}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="RedCancelFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="1.3" CornerRadius="7" TextElement.Foreground="#FF7B8E"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RedCancelFrame" Property="Background" Value="{DynamicResource DialogDangerHover}"/><Setter TargetName="RedCancelFrame" Property="TextElement.Foreground" Value="White"/>
      <Setter TargetName="RedCancelFrame" Property="Effect"><Setter.Value><DropShadowEffect Color="#FF2448" ShadowDepth="0" BlurRadius="14" Opacity="0.8"/></Setter.Value></Setter>
     </Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="RedCancelFrame" Property="Opacity" Value="0.75"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RedCancelFrame" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RedCancelFrame" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DownloadProgress" TargetType="ProgressBar">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
    <Border Background="{DynamicResource DialogInput}" BorderBrush="{DynamicResource DialogAccent}" BorderThickness="1" CornerRadius="6" Padding="2">
     <Grid x:Name="PART_Track" ClipToBounds="True">
      <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource DialogAccent}" CornerRadius="3"/>
      <Border x:Name="Pulse" Visibility="Collapsed" HorizontalAlignment="Left" Width="100" Background="{DynamicResource DialogAccent}" CornerRadius="3"><Border.RenderTransform><TranslateTransform X="-100"/></Border.RenderTransform></Border>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsIndeterminate" Value="True">
      <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/><Setter TargetName="Pulse" Property="Visibility" Value="Visible"/>
      <Trigger.EnterActions><BeginStoryboard x:Name="PulseAnimation"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-100" To="460" Duration="0:0:1.2"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="PulseAnimation"/></Trigger.ExitActions>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="DialogFrame" Background="{DynamicResource DialogSurface}" BorderBrush="{DynamicResource DialogBorder}" BorderThickness="1.3" CornerRadius="10" Padding="18">
  <Grid>
   <Grid Width="110" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-18,30,0" ClipToBounds="True" IsHitTestVisible="False">
    <Path Data="M 86,0 L 110,0 L 80,30 L 56,30 Z" Fill="{DynamicResource DialogAccent}" Opacity="0.10"/>
    <Path Data="M 76,0 L 46,30 M 94,0 L 64,30" Stroke="{DynamicResource DialogAccent}" StrokeThickness="0.8" Opacity="0.55"/>
   </Grid>
   <Grid><Grid.RowDefinitions><RowDefinition Height="51"/><RowDefinition Height="25"/><RowDefinition Height="27"/><RowDefinition Height="14"/><RowDefinition Height="26"/><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
     <Path Data="M 14,1 L 14,22 M 6,14 L 14,22 L 22,14 M 2,25 L 2,31 L 26,31 L 26,25" Stroke="{DynamicResource DialogAccent}" StrokeThickness="2.5" Width="28" Height="33" VerticalAlignment="Top"/>
     <StackPanel Grid.Column="1"><TextBlock x:Name="HeaderText" Text="Update herunterladen" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" FontSize="11" Foreground="{DynamicResource DialogSubtleText}" Margin="0,4,0,0"/></StackPanel>
     <Button x:Name="HeaderCloseButton" Grid.Column="2" Content="×" Foreground="#FF4B4B" FontSize="22" Width="24" Height="25" Padding="0" VerticalAlignment="Top" Margin="0,-5,-4,0" Click="CancelDownload"/>
    </Grid>
    <TextBlock Grid.Row="1" Text="PowerLeitstand-PRO.exe" FontSize="12" Foreground="{DynamicResource DialogSubtleText}"/>
    <Grid Grid.Row="2"><TextBlock x:Name="PhaseText" Text="Download wird vorbereitet …" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="PercentText" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource DialogAccent}"/></Grid>
    <ProgressBar x:Name="DownloadBar" Grid.Row="3" Minimum="0" Maximum="100" IsIndeterminate="True" Style="{StaticResource DownloadProgress}"/>
    <TextBlock x:Name="TransferredText" Grid.Row="4" FontSize="11" Foreground="{DynamicResource DialogSubtleText}" VerticalAlignment="Center"/>
    <TextBlock x:Name="HintText" Grid.Row="5" Text="Anschließend wird die Datei geprüft. Danach startet die App neu." FontSize="11.5" Foreground="{DynamicResource DialogSubtleText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
    <Button x:Name="CancelButton" Grid.Row="6" Height="33" Width="140" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource CancelButtonStyle}" Click="CancelDownload">
     <StackPanel Orientation="Horizontal"><Path Data="M 3,3 L 16,16 M 16,3 L 3,16" Stroke="#FF7B8E" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock x:Name="CancelCaption" Text="Abbrechen" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    </Button>
   </Grid>
  </Grid>
 </Border>
</Window>
