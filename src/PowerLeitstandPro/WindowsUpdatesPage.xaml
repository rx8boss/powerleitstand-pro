<UserControl x:Class="PowerControlProWpf.WindowsUpdatesPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PowerControlProWpf"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <Style x:Key="UpdateSelection" TargetType="CheckBox">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5">
     <Grid><Path x:Name="Tick" Data="M 4,9 L 8,13 L 15,5" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/><Path x:Name="Mixed" Data="M 4,9 H 14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed"/></Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource StandardActionButtonBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Mixed" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="UpdatesCard" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource StandardReferenceCardBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/>
   <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="UpdatesTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style x:Key="UpdatesSub" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="UpdatesAction" TargetType="Button">
   <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,3"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Background" Value="{DynamicResource StandardActionButtonBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="IsEnabled" Value="False"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="UpdateSearchStatus" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/>
   <Setter Property="Padding" Value="7,4"/>
  </Style>
  <Style x:Key="InstallStep" TargetType="Border" BasedOn="{StaticResource UpdateSearchStatus}">
   <Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Padding" Value="4,6"/>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="PageRoot">
 <Grid x:Name="OverviewRoot" Margin="5,3">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="PageScroll" Grid.RowSpan="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" ScrollChanged="PageScrollChanged">
   <StackPanel>
    <Border x:Name="HeaderSurface" Style="{StaticResource UpdatesCard}" Padding="13,8" ClipToBounds="True">
     <Grid x:Name="HeaderGrid">
      <Grid.RowDefinitions><RowDefinition Height="54"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="StripeColumn" Width="120"/></Grid.ColumnDefinitions>
      <Path x:Name="HeaderIcon" Data="M 18,0 L 3,24 L 15,24 L 9,43 L 31,14 L 18,14 Z" Fill="{DynamicResource AccentBrush}" Width="28" Height="36" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock x:Name="PageTitle" Text="System &amp; Software" Style="{StaticResource UpdatesTitle}" FontSize="24"/>
       <TextBlock x:Name="PageSubtitle" Text="Updates, Programme und Autostart" Style="{StaticResource UpdatesSub}" Margin="0,4,0,0"/>
      </StackPanel>
      <Path x:Name="HeaderStripes" Grid.Column="3" Data="M 65,0 L 67,0 L 8,54 L 6,54 Z M 90,0 L 92,0 L 33,54 L 31,54 Z M 94,0 L 110,0 L 51,54 L 35,54 Z" Fill="{DynamicResource AccentBrush}" Opacity="0.18" Width="100" Height="54" Stretch="Fill" HorizontalAlignment="Right" IsHitTestVisible="False"/>
      <StackPanel x:Name="Toolbar" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="ManufacturersButton" Width="166" Style="{StaticResource UpdatesAction}"/>
       <Button x:Name="ProgramsButton" Width="128" Margin="8,0,0,0" Style="{StaticResource UpdatesAction}"/>
       <Button x:Name="PrivacyButton" Width="158" Margin="8,0,0,0" Style="{StaticResource UpdatesAction}"/>
      </StackPanel>
     </Grid>
    </Border>
    <Border x:Name="SearchSurface" Style="{StaticResource UpdatesCard}" Visibility="Collapsed">
     <StackPanel>
      <DockPanel>
       <Button x:Name="CancelSearchButton" DockPanel.Dock="Right" Width="145" Height="31" Margin="8,0,0,0"
               VerticalAlignment="Top" Style="{StaticResource UpdatesAction}" Background="{DynamicResource DangerBrush}"
               BorderBrush="{DynamicResource DangerBorderBrush}" Foreground="White"/>
       <Grid x:Name="SearchRing" DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Top">
        <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" Opacity="0.2" Margin="1"/>
        <Path Data="M 14,2 A 12,12 0 0 1 26,14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
         <Path.RenderTransform><RotateTransform x:Name="SearchRingRotation" CenterX="14" CenterY="14"/></Path.RenderTransform>
        </Path>
       </Grid>
       <StackPanel>
        <TextBlock x:Name="SearchTitle" Style="{StaticResource UpdatesTitle}" FontSize="17" TextWrapping="Wrap"/>
        <TextBlock x:Name="SearchSubtitle" Style="{StaticResource UpdatesSub}" Margin="0,2,0,0"/>
       </StackPanel>
      </DockPanel>
      <UniformGrid x:Name="SearchStatuses" Columns="2" Margin="0,6,0,0">
       <Border x:Name="SoftwareSearchStatus" Style="{StaticResource UpdateSearchStatus}">
        <DockPanel>
         <TextBlock x:Name="SoftwareSearchState" DockPanel.Dock="Right" Style="{StaticResource UpdatesSub}" Margin="6,0,0,0"/>
         <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" DockPanel.Dock="Left" Margin="0,0,7,0"/>
         <TextBlock x:Name="SoftwareSearchLabel" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12"/>
        </DockPanel>
       </Border>
       <Border x:Name="DriverSearchStatus" Style="{StaticResource UpdateSearchStatus}">
        <DockPanel>
         <TextBlock x:Name="DriverSearchState" DockPanel.Dock="Right" Style="{StaticResource UpdatesSub}" Margin="6,0,0,0"/>
         <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" DockPanel.Dock="Left" Margin="0,0,7,0"/>
         <TextBlock x:Name="DriverSearchLabel" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12"/>
        </DockPanel>
       </Border>
      </UniformGrid>
      <local:AnimatedProgressBar x:Name="SearchProgress" Margin="0,7,0,0" Height="15" IsIndeterminate="True" ShowPercentage="False"
                                 Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentBrush}"/>
     </StackPanel>
    </Border>
    <Border x:Name="UpdatesSurface" Style="{StaticResource UpdatesCard}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Path Data="M 24,7 A 12,12 0 1 0 27,21 M 24,2 V 10 H 16" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Width="29" Height="31" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
       <WrapPanel VerticalAlignment="Center">
        <TextBlock x:Name="UpdatesTitle" Style="{StaticResource UpdatesTitle}" Margin="0,0,10,0"/>
        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,1,8,1" VerticalAlignment="Center">
         <TextBlock x:Name="UpdatesWindowsVersion" Style="{StaticResource UpdatesSub}" TextWrapping="NoWrap"/>
        </Border>
        <TextBlock x:Name="UpdatesLastCheck" Style="{StaticResource UpdatesSub}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
       </WrapPanel>
       <TextBlock x:Name="UpdatesSubtitle" Style="{StaticResource UpdatesSub}"/>
      </StackPanel>
      <Button x:Name="SearchUpdatesButton" Grid.Column="2" Width="145" Style="{StaticResource UpdatesAction}" VerticalAlignment="Center"/>
      <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,8,0,0">
       <StackPanel>
       <TextBlock x:Name="UpdatesEmptyState" Style="{StaticResource UpdatesSub}"/>
       <StackPanel x:Name="SoftwareRows"/>
       </StackPanel>
      </Border>
     </Grid>
    </Border>
    <Border x:Name="EsuSurface" Style="{StaticResource UpdatesCard}" Visibility="Collapsed" Padding="12,7">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="225"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Path Data="M 15,1 L 28,6 V 15 C 28,23 22,29 15,32 C 8,29 2,23 2,15 V 6 Z M 9,16 L 13,20 L 21,12"
            Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Width="28" Height="31" Stretch="Uniform" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock x:Name="EsuTitle" Text="Windows 10 ESU" Style="{StaticResource UpdatesTitle}" FontSize="18"/>
       <TextBlock x:Name="EsuEndDate" Style="{StaticResource UpdatesSub}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,10,0">
       <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" Margin="0,4,6,0"/>
        <TextBlock x:Name="EsuStatus" Style="{StaticResource UpdatesSub}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
       </StackPanel>
       <TextBlock x:Name="EsuDescription" Style="{StaticResource UpdatesSub}"/>
      </StackPanel>
      <Button x:Name="EsuDetailsButton" Grid.Column="3" Width="145" Style="{StaticResource UpdatesAction}" IsEnabled="True" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <Border x:Name="DriversSurface" Style="{StaticResource UpdatesCard}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Path Data="M 5,5 H 25 V 25 H 5 Z M 9,0 V 5 M 15,0 V 5 M 21,0 V 5 M 9,25 V 30 M 15,25 V 30 M 21,25 V 30 M 0,9 H 5 M 0,15 H 5 M 0,21 H 5 M 25,9 H 30 M 25,15 H 30 M 25,21 H 30" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Width="29" Height="31" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="DriversTitle" Style="{StaticResource UpdatesTitle}"/><TextBlock x:Name="DriversSubtitle" Style="{StaticResource UpdatesSub}"/></StackPanel>
      <Button x:Name="CheckDriversButton" Grid.Column="2" Width="145" Style="{StaticResource UpdatesAction}" VerticalAlignment="Center"/>
      <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,8,0,0">
       <StackPanel>
       <TextBlock x:Name="DriversEmptyState" Style="{StaticResource UpdatesSub}"/>
       <StackPanel x:Name="DriverRows"/>
       </StackPanel>
      </Border>
     </Grid>
    </Border>
    <Border x:Name="StartupSurface" Style="{StaticResource UpdatesCard}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Path Data="M 15,2 A 13,13 0 1 0 28,15 A 13,13 0 0 0 15,2 M 15,6 V 15 H 23" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Width="28" Height="29" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
       <TextBlock x:Name="StartupTitle" Style="{StaticResource UpdatesTitle}"/>
       <TextBlock x:Name="StartupSubtitle" Style="{StaticResource UpdatesSub}"/>
      </StackPanel>
      <Button x:Name="OpenStartupButton" Grid.Column="2" Width="145" Style="{StaticResource UpdatesAction}" VerticalAlignment="Center"/>
     </Grid>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,5,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,12,0">
    <TextBlock x:Name="ScrollHint" Style="{StaticResource UpdatesSub}" FontSize="10" VerticalAlignment="Center"/>
    <Button x:Name="ReopenOperationButton" Style="{StaticResource UpdatesAction}" IsEnabled="True" HorizontalAlignment="Left" Visibility="Collapsed"/>
   </Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="InstallUpdatesButton" Width="288" Style="{StaticResource UpdatesAction}"/>
    <Button x:Name="WinGetButton" Width="158" Margin="8,0,0,0" Style="{StaticResource UpdatesAction}" ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="30000"/>
   </StackPanel>
  </Grid>
  <Border x:Name="OperationSurface" Grid.RowSpan="3" Panel.ZIndex="1" Visibility="Collapsed" MaxWidth="570"
          VerticalAlignment="Center" Margin="10" Padding="18" CornerRadius="11" BorderThickness="1"
          Background="{DynamicResource StandardReferenceStatusBrush}" BorderBrush="{DynamicResource AccentBrush}">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,11">
     <Path DockPanel.Dock="Left" Data="M18,0 L3,24 L15,24 L9,43 L31,14 L18,14 Z" Fill="{DynamicResource AccentBrush}" Width="24" Height="32" Stretch="Uniform" Margin="0,0,10,0"/>
     <Button x:Name="MinimizeOperationButton" DockPanel.Dock="Right" Style="{StaticResource UpdatesAction}" Content="−" IsEnabled="True" Width="28" Height="26" Padding="0" VerticalAlignment="Top"/>
     <Path DockPanel.Dock="Right" Data="M43,0 L46,0 L4,42 L1,42 Z M60,0 L65,0 L23,42 L18,42 Z M72,0 L83,0 L41,42 L30,42 Z"
           Fill="{DynamicResource AccentBrush}" Opacity="0.25" Width="68" Height="32" Stretch="Uniform" Margin="8,0"/>
     <StackPanel>
      <TextBlock x:Name="OperationTitle" Style="{StaticResource UpdatesTitle}" TextWrapping="Wrap"/>
      <TextBlock x:Name="OperationSummary" Style="{StaticResource UpdatesSub}" Margin="0,2,0,0"/>
     </StackPanel>
    </DockPanel>
    <UniformGrid x:Name="OperationSteps" Grid.Row="1" Columns="4" Margin="0,0,0,8">
     <Border Style="{StaticResource InstallStep}"><TextBlock x:Name="ValidateOperationStep" Style="{StaticResource UpdatesSub}" TextAlignment="Center"/></Border>
     <Border Style="{StaticResource InstallStep}"><TextBlock x:Name="DownloadOperationStep" Style="{StaticResource UpdatesSub}" TextAlignment="Center"/></Border>
     <Border Style="{StaticResource InstallStep}"><TextBlock x:Name="InstallOperationStep" Style="{StaticResource UpdatesSub}" TextAlignment="Center"/></Border>
     <Border Style="{StaticResource InstallStep}" Margin="0"><TextBlock x:Name="FinishOperationStep" Style="{StaticResource UpdatesSub}" TextAlignment="Center"/></Border>
    </UniformGrid>
    <ScrollViewer Grid.Row="2" MaxHeight="64" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,7">
     <Border x:Name="OperationMessage" Padding="0">
      <TextBlock x:Name="OperationText" Style="{StaticResource UpdatesSub}" FontSize="12"/>
     </Border>
    </ScrollViewer>
    <local:AnimatedProgressBar x:Name="OperationProgress" Grid.Row="3" Height="29" Margin="0,0,0,10" Background="{DynamicResource InputBrush}"
                               BorderBrush="{DynamicResource UnifiedAccent}" Foreground="{DynamicResource UnifiedAccent}" IsIndeterminate="True"/>
    <Grid Grid.Row="4">
     <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="OperationList" Style="{StaticResource UpdateSearchStatus}" Padding="4">
      <Grid>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer x:Name="OperationListScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" MaxHeight="158" Focusable="True">
        <StackPanel x:Name="OperationRows"/>
       </ScrollViewer>
       <TextBlock x:Name="OperationListHint" Grid.Row="1" Style="{StaticResource UpdatesSub}" Margin="7,4,0,1" Visibility="Collapsed"/>
      </Grid>
     </Border>
     <Border x:Name="OperationDetails" Grid.Row="1" Style="{StaticResource UpdateSearchStatus}" Visibility="Collapsed" Margin="0,4,0,0">
      <DockPanel>
       <TextBlock x:Name="OperationErrorCode" DockPanel.Dock="Right" Foreground="{DynamicResource DangerBorderBrush}" FontFamily="Consolas"/>
       <TextBlock x:Name="OperationErrorLabel" Style="{StaticResource UpdatesSub}"/>
      </DockPanel>
     </Border>
    </Grid>
    <Grid Grid.Row="5" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="CancelOperationButton" Style="{StaticResource UpdatesAction}" HorizontalAlignment="Left" Margin="0,0,8,0"
              Background="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" Foreground="White"/>
      <Button x:Name="OpenWindowsUpdateButton" Style="{StaticResource UpdatesAction}" HorizontalAlignment="Left"
              IsEnabled="True" Visibility="Collapsed"/>
      <Button x:Name="CollapseOperationButton" Grid.Column="1" Style="{StaticResource UpdatesAction}" MinWidth="116"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>
 <ContentControl x:Name="ManufacturerHost" Visibility="Collapsed"/>
 </Grid>
</UserControl>
