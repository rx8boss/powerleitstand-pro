<Window x:Class="PowerControlProWpf.RepairConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerLeitstand PRO" Icon="Assets/app-icon.ico"
        Width="420" MinHeight="184" MaxHeight="265" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
  <Window.Resources>
    <SolidColorBrush x:Key="DialogBackground" Color="#10283D"/>
    <LinearGradientBrush x:Key="DialogSurface" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#10344F" Offset="0"/>
      <GradientStop Color="#061B30" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DialogText" Color="#F5F9FC"/>
    <SolidColorBrush x:Key="DialogSubtleText" Color="#C4D8E8"/>
    <SolidColorBrush x:Key="DialogAccent" Color="#72BFFA"/>
    <SolidColorBrush x:Key="DialogBorder" Color="#38BCF1"/>
    <SolidColorBrush x:Key="DialogButtonBackground" Color="#24445D"/>
    <SolidColorBrush x:Key="DialogHover" Color="#315D7C"/>
    <SolidColorBrush x:Key="DialogPrimaryBackground" Color="#0754A0"/>
    <SolidColorBrush x:Key="DialogPrimaryHover" Color="#0874C5"/>
    <SolidColorBrush x:Key="DialogDangerBackground" Color="#62283C"/>
    <SolidColorBrush x:Key="DialogDangerBorder" Color="#F06B8B"/>
    <LinearGradientBrush x:Key="DialogSheen" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#24FFFFFF" Offset="0"/>
      <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="DialogButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource DialogText}"/>
      <Setter Property="Background" Value="{DynamicResource DialogButtonBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DialogBorder}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.3"
                CornerRadius="7" SnapsToDevicePixels="True">
          <Grid>
            <Border Background="{DynamicResource DialogSheen}" CornerRadius="6" IsHitTestVisible="False"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DialogHover}"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButton}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{DynamicResource DialogDangerBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DialogDangerBorder}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="RedCancelFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1.3" CornerRadius="7" TextElement.Foreground="#FF7B8E">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="RedCancelFrame" Property="Background" Value="{DynamicResource DialogDangerHover}"/>
            <Setter TargetName="RedCancelFrame" Property="TextElement.Foreground" Value="White"/>
            <Setter TargetName="RedCancelFrame" Property="Effect"><Setter.Value><DropShadowEffect Color="#FF2448" ShadowDepth="0" BlurRadius="14" Opacity="0.8"/></Setter.Value></Setter>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="RedCancelFrame" Property="Opacity" Value="0.75"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RedCancelFrame" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RedCancelFrame" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
      <Setter Property="Background" Value="{DynamicResource DialogPrimaryBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DialogAccent}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.3"
                CornerRadius="7" SnapsToDevicePixels="True">
          <Grid>
            <Border Background="{DynamicResource DialogSheen}" CornerRadius="6" IsHitTestVisible="False"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DialogPrimaryHover}"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="DialogFrame" Background="{DynamicResource DialogSurface}" BorderBrush="{DynamicResource DialogBorder}"
          BorderThickness="1.5" CornerRadius="11" Padding="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="39"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="31"/>
        <RowDefinition Height="12"/>
        <RowDefinition Height="33"/>
      </Grid.RowDefinitions>
      <Grid x:Name="DialogStripes" Grid.RowSpan="6" Width="78" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" ClipToBounds="True">
        <Path Data="M 59,0 L 78,0 L 78,20 L 53,45 L 14,45 Z" Fill="{DynamicResource DialogBorder}" Opacity="0.10"/>
        <Path Data="M 49,0 L 4,45 M 68,0 L 23,45" Stroke="{DynamicResource DialogBorder}" StrokeThickness="0.7" Opacity="0.55"/>
      </Grid>
      <Grid Grid.Row="0" MouseLeftButtonDown="DragDialog">
        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Width="33" Height="33" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Image x:Name="DialogIcon" Width="29" Height="29" HorizontalAlignment="Left"
                 VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Path Data="M 0,-8 L 8,-5 L 7,3 C 6,8 2,11 0,12 C -2,11 -6,8 -7,3 L -8,-5 Z"
                Fill="{DynamicResource DialogBackground}" Stroke="{DynamicResource DialogAccent}"
                StrokeThickness="1.6" Width="15" Height="18" Stretch="Fill"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
          <Path Data="M 0,-5 L 0,6 M -5,0 L 5,0" Stroke="{DynamicResource DialogAccent}"
                StrokeThickness="1.5" Width="7" Height="8" Stretch="Fill"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,5"/>
        </Grid>
        <TextBlock x:Name="DialogHeader" Grid.Column="1" Text="Windows-Reparatur"
                   FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DialogText}"
                   VerticalAlignment="Center"/>
      </Grid>
      <TextBlock x:Name="QuestionText" Grid.Row="1" Margin="44,4,0,0"
                 FontSize="12.5" Foreground="{DynamicResource DialogSubtleText}"
                 TextWrapping="Wrap"/>
      <Border Grid.Row="3" Margin="44,0,0,0" Background="{DynamicResource DialogBackground}"
              BorderBrush="{DynamicResource DialogBorder}" BorderThickness="1" CornerRadius="5">
        <Grid Margin="7,2,3,2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
          <TextBox x:Name="CommandText" Grid.Column="0" IsReadOnly="True" BorderThickness="0"
                   Background="Transparent" Foreground="{DynamicResource DialogAccent}"
                   FontFamily="Consolas" FontSize="11" VerticalContentAlignment="Center"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                   TextWrapping="NoWrap" ToolTip="Befehl markieren und kopieren"/>
          <Button x:Name="CopyButton" Grid.Column="1" Height="25" Margin="4,0,0,0"
                  Style="{StaticResource DialogButton}" FontSize="11" Click="CopyCommand">
            <StackPanel Orientation="Horizontal"><Path Data="M 5,3 L 14,3 L 14,18 L 3,18 L 3,5 L 5,5 M 6,1 L 11,1 L 11,5 L 6,5 Z" Stroke="{DynamicResource DialogAccent}" StrokeThickness="1.5" Width="12" Height="13" Stretch="Uniform" Margin="0,0,4,0"/><TextBlock x:Name="CopyCaption" Text="Kopieren" VerticalAlignment="Center"/></StackPanel>
          </Button>
        </Grid>
      </Border>
      <Grid Grid.Row="5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="StartButton" Grid.Column="0" Height="33" Margin="0,0,5,0"
                Style="{StaticResource DialogButton}" Click="StartDialog" IsDefault="True">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M 3,2 L 17,10 L 3,18 Z" Stroke="{DynamicResource DialogText}"
                  StrokeThickness="1.5" Fill="{DynamicResource DialogText}"
                  Width="14" Height="15" Stretch="Uniform" Margin="0,0,7,0"/>
            <TextBlock x:Name="StartCaption" Text="Reparatur starten" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="CancelButton" Grid.Column="1" Height="33" Margin="5,0,0,0"
                Style="{StaticResource CancelButtonStyle}" Click="CancelDialog" IsCancel="True">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M 3,3 L 16,16 M 16,3 L 3,16" Stroke="#FF4B4B"
                  StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"/>
            <TextBlock x:Name="CancelCaption" Text="Abbrechen" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Grid>
  </Border>
</Window>
